# --- Application ---
APP_NAME=JARVIS AI
APP_ENV=production
DEBUG=false

# --- Sécurité (CHANGE THESE!) ---
# Générer avec: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-key
ENCRYPTION_KEY=change-this-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Base de données (CHANGE PASSWORD!) ---
DATABASE_URL=postgresql+asyncpg://jarvis:CHANGE_THIS_PASSWORD@db:5432/jarvis_db
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=jarvis_db

# --- Redis (CHANGE PASSWORD!) ---
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# --- Fournisseurs IA (REQUIRED FOR PRODUCTION) ---
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
GOOGLE_API_KEY=your-google-key
ELEVENLABS_API_KEY=your-elevenlabs-key
OLLAMA_BASE_URL=http://ollama:11434

# --- OAuth Google (REGISTER IN GOOGLE CLOUD CONSOLE) ---
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/google/callback

# --- CORS (RESTRICT IN PRODUCTION) ---
ALLOWED_ORIGINS=https://app.your-domain.com,https://www.your-domain.com
