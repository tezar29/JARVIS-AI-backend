# Render.com Environment Configuration
# Copy to .env in Render dashboard or set as environment variables

# --- Application ---
APP_NAME=JARVIS AI
APP_ENV=production
DEBUG=false
PORT=1000

# --- Security (Generate new values!)
# Create with: openssl rand -hex 32
SECRET_KEY=change-me-to-random-hex-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (Auto-filled by Render)
# Render automatically injects DATABASE_URL from PostgreSQL service
# Format: postgresql://user:password@host:port/dbname
# If manual: postgresql+asyncpg://jarvis:PASSWORD@localhost:5432/jarvis_db
DATABASE_URL=postgresql+asyncpg://jarvis:PASSWORD@db.internal:5432/jarvis_db
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_THIS
POSTGRES_DB=jarvis_db

# --- Redis (Auto-filled by Render)
# Render automatically injects REDIS_URL from Redis service
# Format: redis://:password@host:port
REDIS_URL=redis://redis.internal:6379/0
REDIS_PASSWORD=

# --- AI Providers (REQUIRED FOR PRODUCTION)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
ELEVENLABS_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# --- OAuth Google
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=https://jarvis-backend.onrender.com/api/v1/auth/google/callback

# --- CORS (Restrict in production)
ALLOWED_ORIGINS=https://jarvis-frontend.onrender.com,https://yourdomain.com
